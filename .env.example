# Server-only values used by api/contact.ts. Never prefix these with VITE_,
# because Vite inlines VITE_ variables into the public browser bundle.

# Option A - Web3Forms. One key, no domain and no DNS setup. Preferred when
# set. Get it from web3forms.com by entering the receiving inbox.
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Option B - Resend. Only needed to send from your own domain, which also
# requires DNS records on that domain.
RESEND_API_KEY=re_your_server_side_key
CONTACT_TO_EMAIL=hello@your-domain.com

# Optional. Use a sender on a domain verified in Resend for production.
CONTACT_FROM_EMAIL=HAYK WEB CO. <website@your-domain.com>
